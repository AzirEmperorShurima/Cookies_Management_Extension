{
    "manifest_version": 3,
    "author": "Justinan - DrakeDev",
    "name": "Thanus - Privacy & Cookie Power Gauntlet",
    "version": "2.2.1",
    "description": "Thanus: The Ultimate Privacy & Browser Power Gauntlet. Manage cookies, Anti-Fingerprinting, PiP Player, SponsorBlock, HLS Downloader, Panic Button, and more.",
    "permissions": [
        "cookies",
        "tabs",
        "tabGroups",
        "storage",
        "identity",
        "management",
        "notifications",
        "privacy",
        "history",
        "sessions",
        "bookmarks",
        "readingList",
        "downloads",
        "contextMenus",
        "webRequest",
        "webRequestAuthProvider",
        "webNavigation",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "sidePanel",
        "alarms",
        "browsingData",
        "scripting",
        "idle",
        "proxy",
        "unlimitedStorage"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "custom_rules",
                "enabled": true,
                "path": "rules.json"
            },
            {
                "id": "easylist_1",
                "enabled": true,
                "path": "rules_easylist_1.json"
            },
            {
                "id": "easylist_2",
                "enabled": true,
                "path": "rules_easylist_2.json"
            },
            {
                "id": "easyprivacy_1",
                "enabled": true,
                "path": "rules_easyprivacy_1.json"
            },
            {
                "id": "easyprivacy_2",
                "enabled": true,
                "path": "rules_easyprivacy_2.json"
            }
        ]
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "host_permissions": [
        "<all_urls>",
        "https://easylist.to/*",
        "https://www.googleapis.com/*",
        "https://accounts.google.com/*"
    ],
    "oauth2": {
        "client_id": "PLACEHOLDER_REPLACE_WITH_YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata"
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon128.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon128.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "telegram_content.js",
                "template/TelegramAdaptiveEngine.js",
                "styles/floating-tab-bar.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "youtube_adblock.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "https://web.telegram.org/*",
                "https://webk.telegram.org/*",
                "https://webz.telegram.org/*"
            ],
            "js": [
                "telegram_content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.cloudflare.com/*",
                "*://challenges.cloudflare.com/*",
                "*://*.hcaptcha.com/*",
                "*://*.recaptcha.net/*",
                "*://*.google.com/recaptcha/*"
            ],
            "js": [
                "videoDetector.js",
                "iframe_content_script.js"
            ],
            "all_frames": true,
            "run_at": "document_start",
            "match_about_blank": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.cloudflare.com/*",
                "*://challenges.cloudflare.com/*",
                "*://*.hcaptcha.com/*",
                "*://*.recaptcha.net/*",
                "*://*.google.com/recaptcha/*"
            ],
            "js": [
                "modules/spoof-inject.js",
                "modules/window-open-hook.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.cloudflare.com/*",
                "*://challenges.cloudflare.com/*",
                "*://*.hcaptcha.com/*",
                "*://*.recaptcha.net/*",
                "*://*.google.com/recaptcha/*"
            ],
            "js": [
                "modules/vendor/tldts.min.js",
                "modules/spoof-bridge.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "modules/cookie-consent-dismiss.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.cloudflare.com/*",
                "*://challenges.cloudflare.com/*",
                "*://*.hcaptcha.com/*",
                "*://*.recaptcha.net/*",
                "*://*.google.com/recaptcha/*"
            ],
            "js": [
                "modules/floating-tab-bar.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "commands": {
        "activate_panic": {
            "suggested_key": {
                "default": "Alt+Shift+X",
                "windows": "Alt+Shift+X",
                "mac": "Alt+Shift+X"
            },
            "description": "Kích hoạt chế độ Panic ngay lập tức"
        },
        "activate_zapper": {
            "suggested_key": {
                "default": "Alt+Z",
                "windows": "Alt+Z",
                "mac": "Alt+Z"
            },
            "description": "Bật/tắt chế độ Zapper xóa phần tử"
        },
        "toggle_spotlight": {
            "suggested_key": {
                "default": "Alt+K",
                "windows": "Alt+K",
                "mac": "Alt+K"
            },
            "description": "Mở thanh lệnh Spotlight Command Palette"
        }
    }
}